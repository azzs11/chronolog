{
  "name": "@chronolog/engine",
  "version": "2.0.0",
  "description": "ChronoLog root-cause engine: pure functions and classes, no I/O",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^5.1.1",
    "typescript": "^5.7.0",
    "vitest": "^5.1.1"
  }
}
