# PostgreSQL
POSTGRES_PASSWORD=debug_secret

# Backend
ADMIN_API_KEY=dev_key_change_in_prod

# Grafana
GRAFANA_PASSWORD=change_me

# Backend port on your machine (5000 is taken by macOS AirPlay)
BACKEND_PORT=5050

# Incident stories (optional, off by default). Runs a local model with Ollama: `ollama pull qwen2.5:3b`
STORY_PROVIDER=off
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2.5:3b
