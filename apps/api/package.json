{
  "name": "chronolog-backend",
  "version": "2.0.0",
  "description": "ChronoLog — Causal Log Intelligence Backend",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@chronolog/engine": "*",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "pg": "^8.13.3",
    "prom-client": "^15.1.3",
    "socket.io": "^4.6.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
